{
  "name": "robloxclient-launcher",
  "productName": "RobloxClient Launcher",
  "version": "1.5.3",
  "description": "Play, host and run the web server for the RobloxClient 2017 bundle.",
  "author": "rbx2017-launcher",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"RobloxClient Launcher\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --ignore=^/dist --ignore=^/dist-installer --ignore=^/node_modules --ignore=^/build",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:full": "electron-builder --win nsis --x64 --publish never --config build/full.config.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "three": "0.149.0"
  },
  "build": {
    "appId": "com.rbx2017.launcher",
    "productName": "RobloxClient Launcher",
    "electronVersion": "45.3.1",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "gamefiles.js",
      "tailscale.js",
      "account.js",
      "package.json",
      "renderer/**/*",
      "!renderer/roblox-logo*.png"
    ],
    "extraFiles": [
      {
        "from": "../Webserver/node",
        "to": "Webserver/node",
        "filter": [
          "**/*",
          "!data{,/**}",
          "!logs{,/**}",
          "!*.pid"
        ]
      },
      {
        "from": "../config/README.txt",
        "to": "config/README.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RobloxClient Launcher",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "RobloxClient-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FilteredAsync",
        "repo": "rbx2017-launcher",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
