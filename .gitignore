# Allow-list: git tracks only this project's own code and docs. Everything
# else stays out: the 2017 client and RCC (Roblox's), place files, the web
# root and tools from the original bundle, caches, saves, keys and builds.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Requirements.txt
!/*.bat
!/*.ps1
!/start-web.sh
!/packaging/
!/tools/
# The public website (Cloudflare Pages, site/README.md).
!/site/
# Scheduled releases (tools/schedule-release.js) and the project's notices to every launcher.
!/.github/
!/announcements.json

!/config/
/config/*
!/config/README.txt
!/config/server.json
!/config/assets.json

!/Launcher/
/Launcher/*
!/Launcher/main.js
!/Launcher/preload.js
!/Launcher/gamefiles.js
!/Launcher/tailscale.js
!/Launcher/account.js
!/Launcher/cleanup.js
!/Launcher/embed.js
!/Launcher/legacy.js
!/Launcher/unzip.js
!/Launcher/changelog.json
# Launcher/default-server.txt (the server address packed into builds) stays untracked.
!/Launcher/package.json
!/Launcher/package-lock.json
!/Launcher/build/
!/Launcher/renderer/
# Roblox's logo: keep your own copy locally (launchers without it get it from
# their server, or show the word).
/Launcher/renderer/roblox-logo*.png

!/Webserver/
/Webserver/*
!/Webserver/node/
/Webserver/node/data/
/Webserver/node/logs/
/Webserver/node/*.pid

# Never, wherever they turn up.
*.log
*.pem
*.dmp
host-key.txt
roblox-api-key.txt
.roblosecurity
menu-music.mp3
